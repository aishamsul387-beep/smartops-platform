{
  "name": "smartops-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests configured yet\"",
    "validate-env": "node ./scripts/validate-env.mjs",
    "verify:release": "npm run validate-env && npm run typecheck && npm run build",
    "smoke": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-test.ps1",
    "snapshot:milestone": "powershell -ExecutionPolicy Bypass -File ./scripts/final-milestone-snapshot.ps1"
  },
  "dependencies": {
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "typescript": "^5.6.3"
  }
}